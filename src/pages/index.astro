---
import Base from '../layouts/Base.astro';
import { guides, stateLabel } from '../data/guides';
---

<Base title="Engineering Atlas" description="A study path through senior frontend and engineering topics.">
  <main class="home">
    <header class="home-head">
      <h1>Engineering Atlas</h1>
      <p>18 guides for senior engineering interviews and design reviews. Study them in order.</p>
    </header>

    <ol class="path">
      {
        guides.map((g) => (
          <li class:list={['stop', { 'is-live': g.href }]}>
            <span class="node" aria-hidden="true" />
            {g.href ? (
              <a href={g.href}>
                <span class="n">{g.number}</span>
                <span class="t">{g.title}</span>
              </a>
            ) : (
              <span class="row">
                <span class="n">{g.number}</span>
                <span class="t">
                  {g.title}
                  {g.optional && <span class="opt"> (optional)</span>}
                </span>
              </span>
            )}
            <span class="s">{stateLabel[g.state]}</span>
          </li>
        ))
      }
    </ol>
  </main>
</Base>

<style>
  .home {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-6) var(--gutter) var(--space-7);
  }

  .home-head h1 {
    font-weight: 850;
    font-variation-settings: 'wdth' 125;
    font-size: clamp(2.25rem, 11vw, 9rem);
    line-height: 0.9;
    letter-spacing: -0.035em;
  }

  .home-head p {
    max-width: 34rem;
    margin-top: var(--space-4);
    color: var(--ink-2);
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    line-height: 1.4;
  }

  .path {
    position: relative;
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .path::before {
    content: '';
    position: absolute;
    left: 8px;
    top: 1.4rem;
    bottom: 1.4rem;
    width: 3px;
    background: var(--faint);
  }

  .stop {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-3) 0 var(--space-3) 44px;
    color: var(--ink-3);
  }

  .node {
    position: absolute;
    left: 0;
    top: calc(var(--space-3) + 0.55rem);
    width: 19px;
    height: 19px;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: inset 0 0 0 3px var(--ink-3);
  }

  .stop.is-live {
    color: var(--ink);
  }

  .stop.is-live .node {
    background: var(--ink);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--ink) 15%, transparent);
  }

  .stop a,
  .row {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    color: inherit;
    text-decoration: none;
  }

  .n {
    flex: none;
    min-width: 2.75rem;
    font-weight: 850;
    font-variation-settings: 'wdth' 125;
    font-variant-numeric: tabular-nums;
  }

  .t {
    font-weight: 750;
    font-variation-settings: 'wdth' 110;
    font-size: clamp(1.25rem, 2.6vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .is-live .t {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .opt {
    font-weight: 500;
    font-size: 0.6em;
  }

  .s {
    font-size: var(--text-small);
    white-space: nowrap;
  }

  .is-live .s {
    color: var(--good);
    font-weight: 700;
  }

  @media (max-width: 40rem) {
    .stop {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .s {
      padding-left: calc(2.75rem + var(--space-3));
    }
  }
</style>
