---
import { guides, stateLabel } from '../data/guides';
import ThemeToggle from './ThemeToggle.astro';

const current = Astro.url.pathname;
---

<header class="site-header">
  <a class="wordmark" href="/">Engineering Atlas</a>
  <nav class="tools" aria-label="Site">
    <button class="hdr-btn" type="button" popovertarget="guides-menu">
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
        <rect x="2" y="2" width="6" height="6"></rect><rect x="12" y="2" width="6" height="6"></rect>
        <rect x="2" y="12" width="6" height="6"></rect><rect x="12" y="12" width="6" height="6"></rect>
      </svg>
      <span class="hdr-label">Guides</span>
    </button>
    <button class="hdr-btn" type="button" data-search-open aria-keyshortcuts="Control+K Meta+K">
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
        <circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <path d="M12.5 12.5 18 18" stroke="currentColor" stroke-width="2.2"></path>
      </svg>
      <span class="hdr-label">Search</span>
    </button>
    <ThemeToggle />
  </nav>
</header>

<div id="guides-menu" class="guides-menu" popover>
  <div class="gm-inner">
    <p class="gm-title">18 guides, in study order</p>
    <ol class="gm-list">
      {
        guides.map((g) => (
          <li>
            {g.href ? (
              <a class="gm-item is-live" href={g.href} aria-current={current === g.href ? 'page' : undefined}>
                <span class="gm-n">{g.number}</span>
                <span class="gm-t">{g.title}</span>
                <span class="gm-s">{stateLabel[g.state]}</span>
              </a>
            ) : (
              <span class="gm-item">
                <span class="gm-n">{g.number}</span>
                <span class="gm-t">
                  {g.title}
                  {g.optional && ' (optional)'}
                </span>
                <span class="gm-s">{stateLabel[g.state]}</span>
              </span>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</div>

<dialog class="search" data-search aria-label="Search the atlas">
  <div class="search-top">
    <p class="search-title">Search</p>
    <button class="hdr-btn" type="button" data-search-close>Close</button>
  </div>
  <div id="search-ui" class="search-ui"></div>
  <p class="search-missing" data-search-missing hidden>
    The search index is created by the production build. Run <code>pnpm build</code>, then <code>pnpm preview</code>.
  </p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-search]')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-search-open]')!;
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-search-close]')!;
  let loaded = false;

  const loadPagefind = () => {
    if (loaded) return;
    loaded = true;
    const css = document.createElement('link');
    css.rel = 'stylesheet';
    css.href = '/pagefind/pagefind-ui.css';
    document.head.append(css);
    const script = document.createElement('script');
    script.src = '/pagefind/pagefind-ui.js';
    script.onload = () => {
      // @ts-expect-error PagefindUI is a global from the script above
      new window.PagefindUI({ element: '#search-ui', showSubResults: true, showImages: false, autofocus: true });
    };
    script.onerror = () => {
      dialog.querySelector<HTMLElement>('[data-search-missing]')!.hidden = false;
    };
    document.head.append(script);
  };

  const open = () => {
    loadPagefind();
    dialog.showModal();
    dialog.querySelector<HTMLInputElement>('input')?.focus();
  };

  openBtn.addEventListener('click', open);
  closeBtn.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  // Choosing a result closes the dialog, so a link to this page shows its target.
  dialog.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('#search-ui a')) dialog.close();
  });
  // Ctrl+K or Cmd+K opens search. A modifier keeps the shortcut from firing while typing.
  document.addEventListener('keydown', (e) => {
    if (e.key.toLowerCase() === 'k' && (e.ctrlKey || e.metaKey) && !e.altKey && !dialog.open) {
      e.preventDefault();
      open();
    }
  });
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    max-width: var(--page-max);
    height: var(--header-h);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .wordmark {
    font-weight: 800;
    font-variation-settings: 'wdth' 120;
    font-size: 1rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .hdr-btn,
  .tools :global(.theme-toggle) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    min-width: 44px;
    justify-content: center;
    padding: 0 var(--space-2);
    border: 0;
    background: none;
    color: var(--ink);
    font-size: var(--text-small);
    cursor: pointer;
  }

  .hdr-btn svg rect {
    fill: currentColor;
  }

  /* The narrowest phones: fit the wordmark and three 44 px buttons in 320 px. */
  @media (max-width: 22rem) {
    .site-header {
      gap: var(--space-2);
    }

    .tools {
      gap: 0;
    }

    .wordmark {
      font-size: 0.9375rem;
    }
  }

  @media (max-width: 40rem) {
    .hdr-btn,
    .tools :global(.theme-toggle) {
      position: relative;
    }

    .hdr-label,
    .tools :global(.theme-label) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* Guides menu: a sheet under the header */
  .guides-menu {
    position: fixed;
    inset: var(--header-h) 0 auto 0;
    width: 100%;
    max-width: none;
    max-height: calc(100svh - var(--header-h));
    margin: 0;
    padding: 0;
    overflow: auto;
    border: 0;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 24px 48px -24px rgb(0 0 0 / 0.35);
  }

  .guides-menu::backdrop {
    background: rgb(0 0 0 / 0.25);
  }

  .gm-inner {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-4) var(--gutter) var(--space-5);
  }

  .gm-title {
    color: var(--ink-2);
    font-size: var(--text-small);
    margin-bottom: var(--space-3);
  }

  .gm-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    column-gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gm-item {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    grid-template-areas: 'n t' 'n s';
    column-gap: var(--space-2);
    padding: var(--space-2) 0;
    color: var(--ink-3);
    text-decoration: none;
  }

  .gm-item.is-live {
    color: var(--ink);
  }

  .gm-item.is-live:hover .gm-t {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .gm-n {
    grid-area: n;
    font-weight: 850;
    font-variation-settings: 'wdth' 125;
  }

  .gm-t {
    grid-area: t;
    font-weight: 650;
  }

  .gm-s {
    grid-area: s;
    font-size: var(--text-small);
    color: var(--ink-3);
  }

  .is-live .gm-s {
    color: var(--good);
  }

  /* Search dialog */
  .search {
    width: min(44rem, calc(100% - 2rem));
    max-height: min(80svh, 44rem);
    margin: var(--space-6) auto auto;
    padding: var(--space-4);
    border: 0;
    border-radius: 12px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 32px 64px -24px rgb(0 0 0 / 0.5);
  }

  .search::backdrop {
    background: rgb(0 0 0 / 0.4);
  }

  .search-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .search-title {
    font-weight: 800;
    font-variation-settings: 'wdth' 118;
    font-size: 1.5rem;
  }

  .search-missing {
    color: var(--ink-2);
    font-size: var(--text-small);
  }

  .search-ui {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--ink);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--paper);
    --pagefind-ui-border: var(--ink-3);
    --pagefind-ui-tag: var(--faint);
    --pagefind-ui-border-width: 2px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: var(--font-body);
  }
</style>
