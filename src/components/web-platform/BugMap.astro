---
import GuideMap, { type Band } from '../GuideMap.astro';
import BugArt from './BugArt.astro';

const bands: Band[] = [
  {
    name: 'Network',
    hint: 'Data arrives',
    zones: [
      {
        n: '4',
        symptom: 'The page shows results for an old search',
        cause: 'Responses arrive in a different order than the requests were sent.',
        href: '#out-of-order',
        art: 'order',
      },
      {
        n: '5',
        symptom: 'Users still see the old version',
        cause: 'The browser reuses a fresh copy and does not ask the server.',
        href: '#http-caching',
        art: 'cache',
      },
      {
        n: '7',
        symptom: 'A crash on undefined, with correct types',
        cause: 'TypeScript checks your code before it runs. It cannot check data that arrives later.',
        href: '#runtime-validation',
        art: 'data',
      },
    ],
  },
  {
    name: 'JavaScript',
    hint: 'Code runs and holds memory',
    zones: [
      {
        n: '2',
        symptom: 'A click does nothing for a moment',
        cause: 'A long task blocks the main thread. The click waits in line.',
        href: '#event-loop',
        art: 'main',
      },
      {
        n: '3',
        symptom: 'Typing lags while data is processed',
        cause: 'Heavy work runs on the main thread when a worker could do it.',
        href: '#web-workers',
        art: 'worker',
      },
      {
        n: '6',
        symptom: 'The tab gets slower after hours',
        cause: 'Something still points to memory the page no longer needs, so it is never freed.',
        href: '#memory-leaks',
        art: 'memory',
      },
    ],
  },
  {
    name: 'Screen',
    hint: 'Pixels appear, in every browser',
    zones: [
      {
        n: '1',
        symptom: 'The page is slow to show, or jumps',
        cause: 'Before you see anything, the browser parses HTML, applies styles, lays out and paints.',
        href: '#render-pipeline',
        art: 'render',
      },
      {
        n: '8',
        symptom: 'It breaks in only one browser',
        cause: 'The page uses a feature that one of your browsers does not support.',
        href: '#browser-support',
        art: 'browsers',
      },
    ],
  },
];
---

<GuideMap bands={bands} art={BugArt} />
