---
// HTTP caching simulator: page, browser cache and server.
// The visitor sets the copy's age and the server's file version,
// then watches the request travel.
// Facts: RFC 9111 §4.2 (fresh iff lifetime > age), §4.3 (validation); MDN HTTP caching.
---

<div class="sim" data-sim>
  <svg width="0" height="0" class="defs" aria-hidden="true">
    <symbol id="glyph-v1" viewBox="0 0 40 40"><circle cx="20" cy="20" r="16"></circle></symbol>
    <symbol id="glyph-v2" viewBox="0 0 40 40">
      <path d="M20 2 L24.5 15.5 L38 20 L24.5 24.5 L20 38 L15.5 24.5 L2 20 L15.5 15.5 Z"></path>
    </symbol>
  </svg>

  <div class="controls">
    <div class="ctl ctl-age">
      <label for="sim-age" class="ctl-label">Age of the browser's copy</label>
      <output for="sim-age" class="ctl-value" data-age-out>2 min</output>
      <div class="track">
        <span class="zone zone-fresh" aria-hidden="true">fresh</span>
        <span class="zone zone-stale" aria-hidden="true">stale</span>
        <input id="sim-age" type="range" min="0" max="600" step="30" value="120"
          aria-describedby="sim-age-hint" data-age />
      </div>
      <div class="scale" aria-hidden="true"><span>0</span><span>5 min</span><span>10 min</span></div>
      <p id="sim-age-hint" class="ctl-hint">
        The server sent the copy with <code>max-age=300</code>. That means fresh for 5 minutes.
      </p>
    </div>

    <fieldset class="ctl ctl-server">
      <legend class="ctl-label">File on the server now</legend>
      <div class="choices">
        <label class="choice">
          <input type="radio" name="sim-server" value="v1" checked data-server />
          <svg class="choice-glyph" width="40" height="40" aria-hidden="true"><use href="#glyph-v1"></use></svg>
          <span class="choice-main">v1</span>
          <span class="choice-sub">same as the copy</span>
        </label>
        <label class="choice">
          <input type="radio" name="sim-server" value="v2" data-server />
          <svg class="choice-glyph" width="40" height="40" aria-hidden="true"><use href="#glyph-v2"></use></svg>
          <span class="choice-main">v2</span>
          <span class="choice-sub">new file deployed</span>
        </label>
      </div>
    </fieldset>
  </div>

  <figure class="stage-wrap">
    <div class="stage" data-stage aria-hidden="true">
      <p class="zone-label zone-browser">Inside the browser</p>
      <p class="zone-label zone-network">Over the network</p>

      <div class="station" data-station="page">
        <div class="draw draw-page">
          <svg class="art" viewBox="0 0 150 116" preserveAspectRatio="none">
            <rect class="frame" x="2" y="2" width="146" height="112" rx="6"></rect>
            <line class="frame" x1="2" y1="24" x2="148" y2="24"></line>
            <circle class="fill" cx="16" cy="13" r="3.5"></circle>
            <circle class="fill" cx="28" cy="13" r="3.5"></circle>
            <circle class="fill" cx="40" cy="13" r="3.5"></circle>
          </svg>
          <div class="content" data-page-content>
            <span class="wait-dots" data-wait><i></i><i></i><i></i></span>
          </div>
        </div>
        <div class="st-text">
          <p class="st-name">Page</p>
          <p class="st-status" data-page-status>waiting</p>
        </div>
      </div>

      <div class="wire wire-a" data-wire="a">
        <span class="line"></span>
        <p class="msg msg-req" data-msg="a-req"></p>
        <p class="msg msg-res" data-msg="a-res"></p>
      </div>

      <div class="station" data-station="cache">
        <div class="draw draw-cache">
          <svg class="art" viewBox="0 0 140 140">
            <circle class="dial-track" cx="70" cy="70" r="50"></circle>
            <circle class="dial" cx="70" cy="70" r="50" pathLength="100" data-dial></circle>
          </svg>
          <div class="content" data-cache-content></div>
        </div>
        <div class="st-text">
          <p class="st-name">Browser cache</p>
          <p class="st-status" data-cache-status></p>
          <p class="st-meta"><code data-cache-etag>ETag: "v1"</code></p>
        </div>
      </div>

      <div class="wire wire-b" data-wire="b">
        <span class="line"></span>
        <p class="msg msg-req" data-msg="b-req"></p>
        <p class="msg msg-res" data-msg="b-res"></p>
        <p class="msg msg-idle" data-msg="b-idle">nothing sent</p>
      </div>

      <div class="station" data-station="server">
        <div class="draw draw-server">
          <svg class="art" viewBox="0 0 96 140">
            <rect class="frame" x="4" y="2" width="88" height="136" rx="8"></rect>
            <line class="frame thin" x1="20" y1="20" x2="76" y2="20"></line>
            <line class="frame thin" x1="20" y1="30" x2="76" y2="30"></line>
            <line class="frame thin" x1="20" y1="110" x2="76" y2="110"></line>
            <line class="frame thin" x1="20" y1="120" x2="76" y2="120"></line>
          </svg>
          <div class="content" data-server-content></div>
        </div>
        <div class="st-text">
          <p class="st-name">Server</p>
          <p class="st-status" data-server-status>has v1</p>
        </div>
      </div>

      <div class="packet" data-packet hidden>
        <span class="tail"></span>
        <span class="head" data-packet-head></span>
      </div>
    </div>
    <figcaption class="visually-hidden">
      The page, the browser cache and the server. The numbered steps below describe each move.
    </figcaption>
  </figure>

  <div class="outcome">
    <div class="verdict" aria-live="polite" data-verdict>
      <p class="v-big" data-v-big></p>
      <p class="v-unit" data-v-unit></p>
      <p class="v-text" data-v-text></p>
    </div>
    <ol class="steps" data-steps></ol>
    <button class="replay" type="button" data-replay>
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
        <path d="M4 10a6 6 0 1 0 2-4.5" fill="none" stroke="currentColor" stroke-width="2.2"></path>
        <path d="M3 2v5h5" fill="none" stroke="currentColor" stroke-width="2.2"></path>
      </svg>
      Play again
    </button>
  </div>
</div>

<script>
  const MAX_AGE = 300; // seconds, from Cache-Control: max-age=300
  const HOP_MS = 950;
  const GAP_MS = 420;

  type Version = 'v1' | 'v2';
  type Node = 'page' | 'cache' | 'server';
  type Msg = 'a-req' | 'a-res' | 'b-req' | 'b-res';
  type Tone = 'ink' | 'net' | 'fresh' | 'stale' | 'wrong';

  type Action =
    | { kind: 'step'; text: string }
    | { kind: 'hop'; from: Node; to: Node; msg: Msg; lines: string[]; carry: Version | '304' | null; tone: Tone }
    | { kind: 'set'; apply: () => void }
    | { kind: 'wait'; ms: number };

  const fmtAge = (s: number) => {
    const m = Math.floor(s / 60);
    const r = s % 60;
    if (m === 0) return `${r} s`;
    return r ? `${m} min ${r} s` : `${m} min`;
  };

  const glyph = (v: Version, size: number) =>
    `<svg class="glyph" width="${size}" height="${size}" aria-hidden="true"><use href="#glyph-${v}"></use></svg>`;

  const fileArt = (v: Version, size: number) =>
    `<span class="file">${glyph(v, size)}<span class="file-label">${v}</span></span>`;

  for (const root of document.querySelectorAll<HTMLElement>('[data-sim]')) {
    const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const ageInput = $<HTMLInputElement>('[data-age]');
    const ageOut = $('[data-age-out]');
    const serverInputs = [...root.querySelectorAll<HTMLInputElement>('[data-server]')];
    const stage = $('[data-stage]');
    const packet = $('[data-packet]');
    const packetHead = $('[data-packet-head]');
    const dial = $<SVGCircleElement>('[data-dial]');
    const stepsEl = $('[data-steps]');
    const verdictEl = $('[data-verdict]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    let runId = 0;

    const state = () => ({
      age: Number(ageInput.value),
      server: (serverInputs.find((i) => i.checked)?.value ?? 'v1') as Version,
    });

    const setTone = (el: Element, tone: Tone | null) => {
      const h = el as HTMLElement;
      if (tone) h.dataset.tone = tone;
      else delete h.dataset.tone;
    };

    const setText = (sel: string, value: string, tone: Tone | null = null) => {
      const el = $(sel);
      el.textContent = value;
      setTone(el, tone);
    };

    const station = (n: Node) => $(`[data-station="${n}"]`);

    const pulse = (n: Node) => {
      if (reduced.matches) return;
      station(n).querySelector('.draw')!.animate(
        [{ transform: 'scale(1)' }, { transform: 'scale(1.06)' }, { transform: 'scale(1)' }],
        { duration: 420, easing: 'cubic-bezier(.3,0,.2,1)' },
      );
    };

    const showCache = (version: Version, age: number, note?: string) => {
      const fresh = age < MAX_AGE;
      const left = Math.max(MAX_AGE - age, 0);
      $('[data-cache-content]').innerHTML = fileArt(version, 36);
      setText('[data-cache-etag]', `ETag: "${version}"`);
      setText(
        '[data-cache-status]',
        note ?? (fresh ? `fresh · ${fmtAge(left)} left` : `stale · checked before use`),
        fresh ? 'fresh' : 'stale',
      );
      dial.style.strokeDasharray = `${(left / MAX_AGE) * 100} 100`;
      station('cache').dataset.fresh = String(fresh);
    };

    const showPage = (version: Version | null, tone: Tone | null, status: string) => {
      $('[data-page-content]').innerHTML = version
        ? fileArt(version, 44)
        : '<span class="wait-dots"><i></i><i></i><i></i></span>';
      setText('[data-page-status]', status, tone === 'wrong' ? 'wrong' : null);
      station('page').dataset.tone = tone ?? '';
    };

    const showServer = (version: Version) => {
      $('[data-server-content]').innerHTML = fileArt(version, 36);
      setText('[data-server-status]', version === 'v2' ? 'has v2 · new' : 'has v1');
    };

    const clearMessages = () => {
      for (const m of root.querySelectorAll<HTMLElement>('[data-msg]')) {
        m.classList.remove('is-on');
        if (m.dataset.msg !== 'b-idle') m.replaceChildren();
      }
      stage.querySelectorAll('.wire').forEach((w) => w.classList.remove('is-used'));
    };

    const showMessage = (msg: Msg, lines: string[], tone: Tone) => {
      const el = $(`[data-msg="${msg}"]`);
      const fwd = msg.endsWith('req');
      el.replaceChildren(
        ...lines.map((line, i) => {
          const row = document.createElement('span');
          row.className = 'msg-line';
          if (i === 0) {
            const arrow = document.createElement('span');
            arrow.className = `arrow ${fwd ? 'arrow-fwd' : 'arrow-back'}`;
            row.append(arrow);
          }
          row.append(document.createTextNode(line));
          return row;
        }),
      );
      setTone(el, tone);
      el.classList.add('is-on');
      el.closest('.wire')!.classList.add('is-used');
    };

    const centre = (n: Node) => {
      const box = station(n).querySelector('.draw')!.getBoundingClientRect();
      const s = stage.getBoundingClientRect();
      return { x: box.left - s.left + box.width / 2, y: box.top - s.top + box.height / 2 };
    };

    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const hop = async (id: number, from: Node, to: Node, carry: Version | '304' | null, tone: Tone) => {
      const a = centre(from);
      const b = centre(to);
      const angle = (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI;
      packet.style.setProperty('--angle', `${angle}deg`);
      packetHead.innerHTML =
        carry === 'v1' || carry === 'v2' ? fileArt(carry, 22) : carry === '304' ? '<span class="file-label">304</span>' : '';
      packet.dataset.shape = carry ? 'doc' : 'dot';
      setTone(packet, tone);
      packet.hidden = false;
      const t = (p: { x: number; y: number }) => `translate(${p.x}px, ${p.y}px)`;
      const anim = packet.animate(
        [
          { transform: t(a), opacity: 0 },
          { transform: t(a), opacity: 1, offset: 0.1 },
          { transform: t(b), opacity: 1, offset: 0.9 },
          { transform: t(b), opacity: 0 },
        ],
        { duration: HOP_MS, easing: 'cubic-bezier(.5,0,.2,1)', fill: 'forwards' },
      );
      await anim.finished.catch(() => {});
      // A newer run owns the packet now; leave it alone.
      if (id !== runId) return;
      packet.hidden = true;
      pulse(to);
    };

    const addStep = (t: string) => {
      for (const li of stepsEl.children) li.classList.remove('is-now');
      const li = document.createElement('li');
      li.className = 'is-now';
      const n = document.createElement('span');
      n.className = 'step-n';
      n.textContent = String(stepsEl.children.length + 1);
      li.append(n, document.createTextNode(t));
      stepsEl.append(li);
    };

    const verdict = (big: string, unit: string, body: string, tone: Tone) => {
      $('[data-v-big]').textContent = big;
      $('[data-v-unit]').textContent = unit;
      $('[data-v-text]').textContent = body;
      setTone(verdictEl, tone);
      verdictEl.classList.add('is-on');
    };

    const plan = (age: number, server: Version): Action[] => {
      const fresh = age < MAX_AGE;
      const changed = server === 'v2';
      const left = MAX_AGE - age;
      const out: Action[] = [
        { kind: 'step', text: 'The page asks for app.js.' },
        { kind: 'hop', from: 'page', to: 'cache', msg: 'a-req', lines: ['GET /app.js'], carry: null, tone: 'ink' },
      ];

      if (fresh) {
        out.push(
          { kind: 'step', text: `The browser has a copy. It is ${fmtAge(age)} old, under 5 minutes, so it is fresh. A fresh copy is used without asking the server.` },
          { kind: 'set', apply: () => $('[data-msg="b-idle"]').classList.add('is-on') },
          { kind: 'wait', ms: GAP_MS },
          { kind: 'hop', from: 'cache', to: 'page', msg: 'a-res', lines: ['copy v1'], carry: 'v1', tone: changed ? 'wrong' : 'fresh' },
          {
            kind: 'set',
            apply: () => {
              if (changed) {
                showPage('v1', 'wrong', 'shows v1 · old file');
                verdict(fmtAge(left), 'of the old file', 'The server has v2, but nobody asked it. Every visit shows v1 until the copy turns stale.', 'wrong');
              } else {
                showPage('v1', 'fresh', 'shows v1');
                verdict('0', 'requests to the server', 'The fresh copy is also the current file. This is the fastest answer possible.', 'fresh');
              }
            },
          },
          { kind: 'step', text: changed ? 'The page shows v1. The server has v2, but nobody asked it.' : 'The page shows v1. Nothing went over the network.' },
        );
        return out;
      }

      out.push(
        { kind: 'step', text: `The browser has a copy. It is ${fmtAge(age)} old, so it is stale. A stale copy must be checked with the server first.` },
        { kind: 'wait', ms: GAP_MS },
        { kind: 'step', text: 'The browser asks: "I have v1. Is it still current?" It sends the copy\'s ETag in the If-None-Match header. An ETag is a name for one version of a file.' },
        { kind: 'hop', from: 'cache', to: 'server', msg: 'b-req', lines: ['GET /app.js', 'If-None-Match: "v1"'], carry: null, tone: 'net' },
        { kind: 'wait', ms: GAP_MS },
      );

      if (!changed) {
        out.push(
          { kind: 'step', text: 'The server still has v1. It answers 304 Not Modified. This answer has no file inside.' },
          { kind: 'hop', from: 'server', to: 'cache', msg: 'b-res', lines: ['304 Not Modified', 'no file'], carry: '304', tone: 'net' },
          { kind: 'set', apply: () => showCache('v1', 0, 'checked · fresh again') },
          { kind: 'wait', ms: GAP_MS },
          { kind: 'hop', from: 'cache', to: 'page', msg: 'a-res', lines: ['copy v1'], carry: 'v1', tone: 'fresh' },
          {
            kind: 'set',
            apply: () => {
              showPage('v1', 'fresh', 'shows v1');
              verdict('304', 'and no file sent', 'The server only confirmed the copy. The check used the network, but the file did not travel again.', 'net');
            },
          },
          { kind: 'step', text: 'The page shows v1. The copy is fresh again for 5 minutes.' },
        );
        return out;
      }

      out.push(
        { kind: 'step', text: 'The server has v2, so the ETags do not match. It answers 200 OK with the new file and its ETag, "v2".' },
        { kind: 'hop', from: 'server', to: 'cache', msg: 'b-res', lines: ['200 OK', 'ETag: "v2" + file'], carry: 'v2', tone: 'net' },
        { kind: 'set', apply: () => showCache('v2', 0, 'new copy · fresh') },
        { kind: 'wait', ms: GAP_MS },
        { kind: 'hop', from: 'cache', to: 'page', msg: 'a-res', lines: ['copy v2'], carry: 'v2', tone: 'fresh' },
        {
          kind: 'set',
          apply: () => {
            showPage('v2', 'fresh', 'shows v2');
            verdict('200', 'and the new file', 'The copy was stale, so the browser asked. The server sent v2, and the page shows the current file.', 'net');
          },
        },
        { kind: 'step', text: 'The page shows v2. The browser keeps it as a new copy, fresh for 5 minutes.' },
      );
      return out;
    };

    const reset = () => {
      const { age, server } = state();
      ageOut.textContent = `${fmtAge(age)} old`;
      stepsEl.replaceChildren();
      clearMessages();
      verdictEl.classList.remove('is-on');
      packet.getAnimations().forEach((a) => a.cancel());
      packet.hidden = true;
      showCache('v1', age);
      showServer(server);
      showPage(null, null, 'waiting');
    };

    const run = async () => {
      const id = ++runId;
      reset();
      const { age, server } = state();
      const instant = reduced.matches;
      for (const a of plan(age, server)) {
        if (id !== runId) return;
        if (a.kind === 'step') addStep(a.text);
        else if (a.kind === 'set') a.apply();
        else if (a.kind === 'wait') {
          if (!instant) await sleep(a.ms);
        } else {
          if (!instant) await hop(id, a.from, a.to, a.carry, a.tone);
          if (id !== runId) return;
          showMessage(a.msg, a.lines, a.tone);
        }
      }
      for (const li of stepsEl.children) li.classList.remove('is-now');
    };

    // Live readout while dragging; play when the visitor pauses.
    let debounce = 0;
    ageInput.addEventListener('input', () => {
      runId++;
      reset();
      clearTimeout(debounce);
      debounce = window.setTimeout(run, 450);
    });
    serverInputs.forEach((i) => i.addEventListener('change', run));
    $('[data-replay]').addEventListener('click', run);

    reset();
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          run();
        }
      },
      { threshold: 0.6 },
    );
    io.observe(stage);
  }
</script>

<style is:global>
  /* Global because the script creates elements; every rule is nested under .sim. */
  .sim {
    --label: var(--diagram-size);
    container: cache-sim / inline-size;
    display: grid;
    gap: var(--space-5);

    @media (max-width: 62rem) {
      gap: var(--space-4);
    }

    .defs {
      position: absolute;
    }

    /* ---------- Controls ---------- */
    .controls {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: var(--space-5) var(--space-6);
      align-items: start;
    }

    .ctl {
      margin: 0;
      padding: 0;
      border: 0;
      min-width: 0;
    }

    .ctl-label {
      display: block;
      padding: 0;
      color: var(--ink-2);
      font-size: var(--text-small);
      font-weight: 650;
    }

    .ctl-value {
      display: block;
      margin: var(--space-2) 0 var(--space-4);
      font-weight: 850;
      font-variation-settings: 'wdth' 125;
      font-size: clamp(2.5rem, 5vw, 3.75rem);
      line-height: 1;
      letter-spacing: -0.02em;
      font-variant-numeric: tabular-nums;
    }

    .ctl-hint {
      margin-top: var(--space-3);
      color: var(--ink-2);
      font-size: var(--text-small);
    }

    .track {
      position: relative;
      display: grid;
      grid-template-columns: 1fr 1fr;
      height: 56px;
    }

    .zone {
      display: flex;
      align-items: center;
      padding-inline: var(--space-3);
      font-size: var(--label);
      font-weight: 700;
    }

    .zone-fresh {
      color: var(--good);
      background: color-mix(in srgb, var(--good) 15%, var(--paper));
    }

    .zone-stale {
      justify-content: flex-end;
      color: var(--warn);
      background: repeating-linear-gradient(
        -45deg,
        color-mix(in srgb, var(--warn) 24%, var(--paper)) 0 5px,
        color-mix(in srgb, var(--warn) 7%, var(--paper)) 5px 11px
      );
    }

    .track input {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      margin: 0;
      background: transparent;
      appearance: none;
      cursor: ew-resize;
    }

    .track input::-webkit-slider-runnable-track {
      height: 100%;
      background: transparent;
    }

    .track input::-moz-range-track {
      height: 100%;
      background: transparent;
    }

    .track input::-webkit-slider-thumb {
      appearance: none;
      width: 10px;
      height: 76px;
      margin-top: -10px;
      background: var(--ink);
      border: 0;
      border-radius: 5px;
    }

    .track input::-moz-range-thumb {
      width: 10px;
      height: 76px;
      background: var(--ink);
      border: 0;
      border-radius: 5px;
    }

    .track input:focus-visible {
      outline-offset: 14px;
    }

    .scale {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      margin-top: var(--space-3);
      color: var(--ink-2);
      font-size: var(--label);
    }

    .scale span:last-child {
      text-align: right;
    }

    .choices {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4);
      margin-top: var(--space-4);
    }

    .choice {
      position: relative;
      display: grid;
      grid-template-columns: auto 1fr;
      grid-template-areas: 'glyph main' 'glyph sub';
      column-gap: var(--space-3);
      align-items: center;
      padding-bottom: var(--space-3);
      color: var(--ink-3);
      cursor: pointer;
      transition: color 0.2s ease;
    }

    .choice input {
      position: absolute;
      inset: 0;
      opacity: 0;
      margin: 0;
      cursor: pointer;
    }

    .choice::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 2px;
      background: var(--faint);
      transition: height 0.2s ease, background 0.2s ease;
    }

    .choice:has(input:checked) {
