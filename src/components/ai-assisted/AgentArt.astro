---
import '../../styles/art.css';

export type Art = 'task' | 'context' | 'scope' | 'check' | 'learn' | 'measure';

interface Props {
  art: Art;
  class?: string;
}

const { art, class: className } = Astro.props;
---

<svg class={`guide-art ${className ?? ''}`} viewBox="0 0 176 72" width="176" height="72" aria-hidden="true">
  {art === 'task' && (
    <>
      <path class="stroke" d="M6 2 V66 H172" />
      <circle class="ink" cx="112" cy="54" r="4" />
      <circle class="good" cx="148" cy="48" r="6" />
      <circle class="ink" cx="158" cy="22" r="4" />
      <circle class="bad" cx="40" cy="16" r="7" />
    </>
  )}
  {art === 'context' && (
    <>
      <rect class="frame" x="6" y="4" width="64" height="64" rx="4" />
      <rect class="ink" x="16" y="16" width="44" height="5" />
      <rect class="ink" x="16" y="30" width="30" height="5" />
      <line class="dash" x1="16" y1="46" x2="60" y2="46" />
      <path class="stroke" d="M84 36 H118 M110 28 118 36 110 44" />
      <rect class="frame dashed" x="128" y="14" width="42" height="44" rx="4" />
    </>
  )}
  {art === 'scope' && (
    <>
      <circle class="ink" cx="22" cy="36" r="10" />
      <line class="stroke" x1="34" y1="36" x2="76" y2="36" />
      <circle class="ink" cx="88" cy="36" r="10" />
      <line class="dash" x1="100" y1="36" x2="114" y2="36" />
      <path class="bad-stroke" d="M120 26 128 46" />
      <line class="dash" x1="132" y1="36" x2="142" y2="36" />
      <circle class="frame faded" cx="156" cy="36" r="10" />
    </>
  )}
  {art === 'check' && (
    <>
      <rect class="bad" x="6" y="10" width="104" height="8" />
      <rect class="good" x="6" y="26" width="128" height="8" />
      <rect class="ink" x="6" y="42" width="84" height="8" />
      <circle class="stroke" cx="146" cy="46" r="13" />
      <line class="stroke" x1="156" y1="56" x2="168" y2="68" />
    </>
  )}
  {art === 'learn' && (
    <>
      <line class="thin" x1="2" y1="68" x2="174" y2="68" />
      <rect class="ink" x="34" y="8" width="40" height="60" />
      <rect class="bad" x="102" y="20" width="40" height="48" />
    </>
  )}
  {art === 'measure' && (
    <>
      <line class="thin" x1="88" y1="2" x2="88" y2="70" />
      <rect class="frame faded" x="41" y="9.5" width="45" height="9" />
      <rect class="frame faded" x="49" y="31.5" width="37" height="9" />
      <rect class="bad" x="88" y="52" width="40" height="12" />
    </>
  )}
</svg>
