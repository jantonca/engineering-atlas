---
import '../../styles/sim.css';

// One pull request from an agent. Each choice is a change you could question first.
const CHOICES = [
  {
    id: 'code',
    file: 'refund.ts',
    lines: [
      { sign: ' ', code: 'export function needsApproval(amount: number) {' },
      { sign: '+', code: '  return amount >= 500;' },
    ],
    note: 'Yes, this is the bug: >= sends a $500 refund for approval. You find it by reading the line against the requirement. Then look at the test change: it is why the tests still pass.',
  },
  {
    id: 'test',
    file: 'refund.test.ts',
    lines: [
      { sign: '-', code: "test('$500 goes through', () => expect(needsApproval(500)).toBe(false));" },
      { sign: '+', code: "test('$499 goes through', () => expect(needsApproval(499)).toBe(false));" },
    ],
    note: 'Yes, this is the loudest signal. The same pull request changes the behaviour and the test that described it. The old test said what the requirement says. The agent changed it until it passed.',
  },
  {
    id: 'kept',
    file: 'refund.test.ts',
    lines: [{ sign: ' ', code: "test('$501 needs approval', () => expect(needsApproval(501)).toBe(true));" }],
    note: 'This test is fine, and it passes. It shows that a refund over $500 is stopped. It says nothing about $500 itself.',
  },
  {
    id: 'none',
    file: 'Nothing',
    lines: [{ sign: ' ', code: 'All 14 tests pass, and the types are correct.' }],
    note: 'Both are true, and the feature is still wrong. Passing checks tell you what was checked, not that the requirement holds.',
  },
];
---

<div class="sx dc" data-dc>
  <div class="dc-brief">
    <div>
      <p class="sx-label">The requirement</p>
      <p class="dc-req">Refunds <strong>over</strong> $500 need a manager's approval. A refund of $500 or less goes through.</p>
    </div>
    <div>
      <p class="sx-label">The agent's summary</p>
      <p class="dc-summary">“Added the approval check for large refunds. Updated one test that no longer matched. All 14 tests pass.”</p>
    </div>
  </div>

  <fieldset class="sx-ctl">
    <legend class="sx-label">The diff. Which change would you question first?</legend>
    <div class="dc-diff">
      {
        CHOICES.map((c) => (
          <label class="dc-choice">
            <input type="radio" name="dc-pick" value={c.id} />
            <span class="dc-file">{c.file}</span>
            {c.lines.map((l) => (
              <code class={`dc-line ${l.sign === '+' ? 'is-add' : l.sign === '-' ? 'is-del' : ''}`}>
                <span class="dc-sign" aria-hidden="true">{l.sign}</span>
                <span class="visually-hidden">{l.sign === '+' ? 'Added: ' : l.sign === '-' ? 'Removed: ' : ''}</span>
                {/* On narrow screens, break before .toBe rather than inside a word. */}
                {l.code.split('.toBe').map((part, i) => (i === 0 ? part : <><wbr />.toBe{part}</>))}
              </code>
            ))}
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="dc-notes" aria-live="polite">
    <p class="dc-hint" data-for="unpicked">Pick one to see what a careful reviewer would say.</p>
    {CHOICES.map((c) => <p data-for={c.id} hidden>{c.note}</p>)}
  </div>

  <details class="dc-reveal">
    <summary>Show the input that breaks it</summary>
    <div class="dc-break">
      <p><code>needsApproval(500)</code> now returns <code>true</code>. The requirement says a $500 refund goes through.</p>
      <ul class="dc-checks">
        <li><span class="dc-ok" aria-hidden="true">✓</span> <strong>Types pass.</strong> A number goes in and a boolean comes out.</li>
        <li><span class="dc-ok" aria-hidden="true">✓</span> <strong>Tests pass.</strong> The test that would have failed was changed.</li>
        <li><span class="dc-ok" aria-hidden="true">✓</span> <strong>The summary is honest.</strong> It did say it updated a test.</li>
        <li><span class="dc-bad" aria-hidden="true">✗</span> <strong>The requirement fails.</strong> Reading the diff against it, or running the $500 case, shows the bug.</li>
      </ul>
    </div>
  </details>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-dc]')) {
    // Browsers can restore the checked radio on reload, so read the input, not the markup.
    const sync = () => {
      const pick = root.querySelector<HTMLInputElement>('[name="dc-pick"]:checked')?.value ?? 'unpicked';
      for (const note of root.querySelectorAll<HTMLElement>('[data-for]')) note.hidden = note.dataset.for !== pick;
      for (const input of root.querySelectorAll<HTMLInputElement>('[name="dc-pick"]')) {
        input.closest('.dc-choice')!.classList.toggle('is-on', input.checked);
      }
    };
    root.addEventListener('change', sync);
    sync();
  }
</script>

<style is:global>
  .dc .dc-brief {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-5);
  }

  .dc .dc-req,
  .dc .dc-summary {
    margin: var(--space-2) 0 0;
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    font-weight: 700;
    line-height: 1.3;
  }

  .dc .dc-summary {
    color: var(--ink-2);
    font-weight: 500;
  }

  .dc-diff {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .dc-choice {
    position: relative;
    display: grid;
    gap: 2px;
    padding: var(--space-3);
    border-radius: 8px;
    box-shadow: inset 0 0 0 2px var(--faint);
    cursor: pointer;
  }

  .dc-choice input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  /* The script marks the chosen card, and :focus-within shows focus, so neither needs :has(). */
  .dc-choice.is-on {
    box-shadow: inset 0 0 0 4px var(--ink);
  }

  .dc-choice:focus-within {
    outline: 3px solid var(--net);
    outline-offset: 3px;
  }

  .dc-file {
    color: var(--ink-2);
    font-size: var(--text-small);
    font-weight: 700;
  }

  /* The code font joins >= into one sign. Here the exact characters are the lesson. */
  .dc-line {
    display: block;
    font-variant-ligatures: none;
    overflow-wrap: anywhere;
    /* Hang the +/- sign so wrapped lines line up with the code. */
    padding: 2px var(--space-2) 2px calc(var(--space-2) + 1.25em);
    text-indent: -1.25em;
    border-radius: 4px;
    font-size: 0.875rem;
  }

  .dc-line.is-add {
    background: color-mix(in srgb, var(--good) 14%, var(--paper));
  }

  .dc-line.is-del {
    background: color-mix(in srgb, var(--bad) 12%, var(--paper));
    text-decoration: line-through;
    text-decoration-color: color-mix(in srgb, var(--bad) 60%, transparent);
  }

  /* text-indent is inherited; without this reset the sign moves left twice. */
  .dc-sign {
    display: inline-block;
    width: 1.25em;
    text-indent: 0;
    font-weight: 800;
  }

  .dc-notes {
    max-width: 44rem;
    min-height: 4.5rem;
    font-size: clamp(1.0625rem, 1.5vw, 1.2rem);
    font-weight: 600;
    text-wrap: pretty;
  }

  .dc-notes p {
    margin: 0;
  }

  .dc-notes .dc-hint {
    color: var(--ink-2);
    font-weight: 500;
  }

  .dc-reveal summary {
    width: fit-content;
    min-height: 48px;
    display: flex;
    align-items: center;
    padding: 0 var(--space-4);
    border-radius: 24px;
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .dc-reveal summary::-webkit-details-marker {
    display: none;
  }

  .dc-reveal summary:focus-visible {
    outline: 3px solid var(--net);
    outline-offset: 3px;
  }

  .dc-break {
    max-width: 44rem;
    margin-top: var(--space-4);
    font-size: clamp(1.0625rem, 1.5vw, 1.2rem);
  }

  .dc-break p {
    margin: 0 0 var(--space-3);
    font-weight: 700;
  }

  .dc-checks {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dc-ok,
  .dc-bad {
    display: inline-block;
    width: 1.25em;
    font-weight: 800;
  }

  .dc-ok { color: var(--good); }
  .dc-bad { color: var(--bad); }

  @media (max-width: 52rem) {
    .dc .dc-brief {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
