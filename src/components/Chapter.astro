---
interface Props {
  id: string;
  n: string;
  topic: string;
  question: string;
  title: string;
}

const { id, n, topic, question, title } = Astro.props;
---

<section class="chapter" id={id} aria-labelledby={`${id}-title`}>
  <header class="ch-head">
    <h2 id={`${id}-title`} class="ch-kicker"><span class="ch-n">{n}</span> {topic}</h2>
    <p class="ch-question">{question}</p>
    <p class="ch-title">{title}</p>
    <div class="ch-answer"><slot name="answer" /></div>
  </header>
  <div><slot /></div>
  {
    Astro.slots.has('after') && (
      <div class="ch-after">
        <slot name="after" />
      </div>
    )
  }
</section>

<style>
  .chapter {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-6) var(--gutter) var(--space-7);
  }

  /* Short enough that the first control of the scene shows in the opening view. */
  .ch-head {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    text-align: center;
  }

  .ch-kicker {
    margin: 0;
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
    color: var(--ink-2);
    font-weight: 700;
    font-size: var(--text-small);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ch-n {
    color: var(--ink);
    font-weight: 850;
    font-variation-settings: 'wdth' 125;
    letter-spacing: 0;
  }

  .ch-question {
    max-width: 34rem;
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    font-weight: 600;
    line-height: 1.35;
    text-wrap: balance;
  }

  .ch-question::before {
    content: '“';
  }

  .ch-question::after {
    content: '”';
  }

  .ch-title {
    max-width: 14ch;
    font-weight: 850;
    font-variation-settings: 'wdth' 118;
    font-size: clamp(2.75rem, 7vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .ch-answer {
    max-width: var(--measure);
    color: var(--ink-2);
    font-size: clamp(1.125rem, 1.6vw, 1.3rem);
    text-wrap: pretty;
  }

  .ch-answer :global(p + p) {
    margin-top: var(--space-3);
  }

  .ch-after {
    max-width: var(--measure);
    margin: var(--space-6) auto 0;
    color: var(--ink-2);
    font-size: var(--text-small);
  }

  .ch-after :global(p + p),
  .ch-after :global(h3 + p) {
    margin-top: var(--space-3);
  }

  .ch-after :global(ul) {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-2);
    padding-left: 1.25rem;
  }

  .ch-after :global(h3) {
    margin-top: var(--space-5);
    color: var(--ink);
    font-size: var(--text);
    font-weight: 750;
  }

  .ch-after :global(h3:first-child) {
    margin-top: 0;
  }
</style>
